{
  "manifest_version": 3,
  "name": "calc",
  "version": "1.0",
  "description": "A compact arcade of games inside your Chrome popup.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
